# ==========================================
# SkyRoute - Environment Variables Template
# ==========================================

# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL 16 + PostGIS 3.4
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=skyroute
DB_PASSWORD=skyroute_secret
DB_NAME=skyroute_db

# Redis 7 Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
WEATHER_CACHE_TTL_SEC=1800

# JWT Authentication
JWT_ACCESS_SECRET=change_me_access_secret_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
JWT_REFRESH_EXPIRES_IN=7d

# Weather API (Open-Meteo - No API Key Required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
RAIN_CONFLICT_THRESHOLD_PCT=60
DETOUR_WARNING_KM=8.0
PLAN_B_RADIUS_METERS=3000

# AI Copilot (Google Gemini API)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-3.8-flash

# Frontend (Next.js 15)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
